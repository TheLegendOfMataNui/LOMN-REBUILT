    method process(param1) {
        if (this.printlock) {
            if (scprinter::isdone(this.printer)) {
                this.printlock = 0;
                this.printtext.cleanupfull();
            }
        }
        return null;
    }
    
    method onevent(param1) {
        if (this.active && (this.printlock == 0)) {
            if (param1.eventid == 25) {
                this.mousebuttonreleased(param1.args[0]);
            }
            else if (param1.eventid == 26) {
                this.checkmousepos(param1.args[0], param1.args[1]);
            }
        }
        return null;
    }
    
    method input(param1) {
        if (this.active && (this.printlock == 0)) {
            if (param1.event == 2) {
                if ((param1.button == 27) || (param1.button == 8)) {
                    this.back();
                }
            }
        }
        return null;
    }
    
    method hide() {
        this.background1.hide();
        this.backopt1.image.hide();
        this.backopt1.lit = 0;
        foreach (var imagelist : this.imagelist) {
            imagelist.hide();
        }
        return null;
    }
    
    method show() {
        this.background1.show();
        foreach (var imagelist : this.imagelist) {
            imagelist.show();
        }
        return null;
    }
    
    method back() {
        this.cleanupshort();
        this.parent.initfull();
        this.parent.active = 1;
        gcstaticsoundsptrarray::playtablesound(1073);
        return null;
    }
    
    method forward() {
        this.cleanupshort();
        this.parent.forward();
        return null;
    }
    
    method checkmousepos(mouse_x, mouse_y) {
        var var1;
        var1 = 0;
        if (this.subon) {
            if (this.backopt2.check(mouse_x, mouse_y)) {
                var1 = 1;
            }
            foreach (var optlist : this.optlist) {
                if (var1) {
                    optlist.check(0, 0);
                }
                else if (optlist.check(mouse_x, mouse_y)) {
                    var1 = 1;
                }
            }
        }
        else {
            if (this.backopt1.check(mouse_x, mouse_y)) {
                var1 = 1;
            }
            foreach (var imagelist : this.imagelist) {
                if (var1) {
                    imagelist.check(0, 0);
                }
                else if (imagelist.check(mouse_x, mouse_y)) {
                    var1 = 1;
                }
            }
        }
        return null;
    }

    //click returns 1 for left click, 2 for right click.  This arg gets passed from onevent 25 (see onevent method)  
    method mousebuttonreleased(click) {
        var var1;
        if (click == 1) {
            if (this.subon) {
                if (this.backopt2.lit) {
                    this.switchtomenu();
                    gcstaticsoundsptrarray::playtablesound(1073);
                }
                else {
                    var1 = 0;
                    while ((this.optlist.__length - 1) >= var1) {
                        if (this.optlist[var1].lit) {
                            this.print(var1);
                        }
                        var1 = var1 + 1;
                    }
                    gcstaticsoundsptrarray::playtablesound(1074);
                }
            }
            else if (this.backopt1.lit) {
                this.back();
            }
            else {
                var1 = 0;
                while ((this.imagelist.__length - 1) >= var1) {
                    if (this.imagelist[var1].selectable) {
                        if (this.imagelist[var1].highlight.lit) {
                            this.switchtoprint(var1);
                        }
                    }
                    var1 = var1 + 1;
                }
                gcstaticsoundsptrarray::playtablesound(1074);
            }
        }
        else if (click == 2) {
            this.back();
        }
        return null;
    }
    
