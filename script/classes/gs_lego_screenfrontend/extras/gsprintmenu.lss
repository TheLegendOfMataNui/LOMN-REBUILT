            this.backopt2 = null;
        }
        if (this.image2 != null) {
            this.image2.hide();
            this.image2.remove();
            this.image2.cleanupfull();
            this.image2 = null;
        }
        if (this.optlist != null) {
            var1 = 0;
            while ((this.optlist.__length - 1) >= var1) {
                this.optlist[var1].cleanupfull();
                this.optlist[var1] = null;
                var1 = var1 + 1;
            }
            this.optlist = null;
        }
        return null;
