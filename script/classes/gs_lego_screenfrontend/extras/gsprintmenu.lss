    method switchtomenu() {
        var var1;
        this.subon = 0;
        this.show();
        this.background2.hide();
        this.background2.remove();
        this.background2.cleanupfull();
        this.background2 = null;
        this.backopt2.cleanupfull();
        this.backopt2 = null;
        if (this.image2 != null) {
            this.image2.hide();
            this.image2.remove();
            this.image2.cleanupfull();
            this.image2 = null;
        }
        if (this.optlist != null) {
            var1 = 0;
            while ((this.optlist.__length - 1) >= var1) {
                this.optlist[var1].cleanupfull();
                this.optlist[var1] = null;
                var1 = var1 + 1;
            }
            this.optlist = null;
        }
        return null;
    }
    
    method print(num_of_pages) {
        var pages;
        var filename;
        var description;
        debug::print("Printing...");
        pages = 1;
        if (num_of_pages == 0) {
            pages = 1;
        }
        else if (num_of_pages == 1) {
            pages = 2;
        }
        else if (num_of_pages == 2) {
            pages = 3;
        }
        else if (num_of_pages == 3) {
            pages = 6;
        }
        else if (num_of_pages == 4) {
            pages = 8;
        }
        if (this.idx == 1) {
            filename = "fg";
            description = "Toa Mata team poster";
        }
        else if (this.idx == 2) {
            filename = "fi";
            description = "Island of Mata Nui poster";
        }
        else if (this.idx == 3) {
            filename = "op";
            description = "Onua and Whenua poster";
        }
        else if (this.idx == 4) {
            filename = "oa";
            description = "Onua action set poster ";
        }
        else if (this.idx == 5) {
            filename = "oc.jpg";
            description = "Fikou-Nui concept art";
        }
        else if (this.idx == 6) {
            filename = "om.jpg";
            description = "Mud monster concept art";
        }
        else if (this.idx == 7) {
            filename = "gp";
            description = "Gali and Nokama poster";
        }
        else if (this.idx == 8) {
            filename = "ga";
            description = "Gali action set poster";
        }
        else if (this.idx == 9) {
            filename = "gc.jpg";
            description = "Gali waterfall leap concept art";
        }
        else if (this.idx == 10) {
            filename = "gm.jpg";
            description = "Water monster concept art";
        }
        else if (this.idx == 11) {
            filename = "pp";
            description = "Pohatu and Onewa poster";
        }
        else if (this.idx == 12) {
            filename = "pa";
            description = "Onua meets Pohatu poster";
        }
        else if (this.idx == 13) {
            filename = "pc.jpg";
            description = "Pohatu tossed from Kane-Ra concept art";
        }
        else if (this.idx == 14) {
            filename = "pm.jpg";
            description = "Rock monster concept art";
        }
        else if (this.idx == 15) {
            filename = "kp";
            description = "Kopaka and Nuju poster";
        }
        else if (this.idx == 16) {
            filename = "ka";
            description = "Kopaka action set poster";
        }
        else if (this.idx == 17) {
            filename = "kc.jpg";
            description = "Kopaka Akaku puzzle concept art";
        }
        else if (this.idx == 18) {
            filename = "km.jpg";
            description = "Ice monster concept art";
        }
        else if (this.idx == 19) {
            filename = "lp";
            description = "Lewa and Matau poster";
        }
        else if (this.idx == 20) {
            filename = "la";
            description = "Lewa action set poster";
        }
        else if (this.idx == 21) {
            filename = "lc.jpg";
            description = "Lewa carried by Nui-Rama concept art";
        }
        else if (this.idx == 22) {
            filename = "lm.jpg";
            description = "Wind monster concept art";
        }
        else if (this.idx == 23) {
            filename = "tp";
            description = "Tahu and Vakama poster";
        }
        else if (this.idx == 24) {
            filename = "ta";
            description = "Tahu action set poster";
        }
        else if (this.idx == 25) {
            filename = "tc.jpg";
            description = "Tahu lava board boulder chase concept art";
        }
        else if (this.idx == 26) {
            filename = "tm.jpg";
            description = "Tahu level concept art";
        }
        else if (this.idx == 27) {
            filename = "tp.jpg";
            description = "desc";
        }
        else if (this.idx == 28) {
            filename = "tp.jpg";
            description = "desc";
        }
        if ((num_of_pages >= 0) && (num_of_pages <= (this.imagelist.__length - 1))) {
            var print_file = scprinter::printfile(this.printer, filename, description, pages);
            this.printlock = 1;
            this.printtext.initfull();
            this.printtext.add();
            this.printtext.show();
        }
        return null;
    }

    method printerglyphs() {
        if ((globalclass.unlockdirector.unlocks.printonua) == 1) {
            this.onuapics = [
                new printmenupic("Root/data/art/PrintMenu/ops1", 238, 48, 302, 112, "Root/data/art/PrintMenu/HL03", 221, 37, 317, 133, 1), 
                new printmenupic("Root/data/art/PrintMenu/oas1", 338, 48, 402, 112, "Root/data/art/PrintMenu/HL04", 322, 37, 418, 133, 1), 
                new printmenupic("Root/data/art/PrintMenu/ocs1", 438, 48, 502, 112, "Root/data/art/PrintMenu/HL05", 422, 37, 518, 133, 1), 
                new printmenupic("Root/data/art/PrintMenu/oms1", 538, 48, 602, 112, "Root/data/art/PrintMenu/HL06", 522, 37, 618, 133, 1) ];
            foreach (var onuapics : this.onuapics) {
                this.imagelist.__append(onuapics);
            }
        }
        else {
            this.onuapics = [
                new printmenupic("Root/data/art/PrintMenu/ops1", 9999, 48, 9999, 112, "Root/data/art/PrintMenu/HL03", 9999, 37, 9999, 133, 1), 
                new printmenupic("Root/data/art/PrintMenu/oas1", 9999, 48, 9999, 112, "Root/data/art/PrintMenu/HL04", 9999, 37, 9999, 133, 1), 
                new printmenupic("Root/data/art/PrintMenu/ocs1", 9999, 48, 9999, 112, "Root/data/art/PrintMenu/HL05", 9999, 37, 9999, 133, 1), 
                new printmenupic("Root/data/art/PrintMenu/oms1", 9999, 48, 9999, 112, "Root/data/art/PrintMenu/HL06", 9999, 37, 9999, 133, 1) ];
            foreach (var onuapics : this.onuapics) {
                this.imagelist.__append(onuapics);
            }
        }
        if ((globalclass.unlockdirector.unlocks.printgali) == 1) {
            this.galipics = [
