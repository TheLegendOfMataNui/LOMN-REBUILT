    property printtext;
    
    method gsprintmenu(param1) {
        this.parent = param1;
        this.active = 0;
        return null;
    }
    
    method initfull() {
        var var1;
        this.active = 1;
        this.subon = 0;
        this.background1 = new ss_basesprite("Root/data/art/PrintMenu/BACKGROUND01", 0, 0, 0, 640, 480);
        this.background1.initfull();
        this.background1.add();
        this.background1.show();
        this.backopt1 = new printmenuhighlight("Root/data/art/PrintMenu/HL_ARROW01", 531, 353, 627, 481);
        this.backopt1.initfull();
        this.imagelist = [   ];
        this.defaultpics = [ 
            new printmenupic("Root/data/art/PrintMenu/fgs1", 38, 48, 102, 112, "Root/data/art/PrintMenu/HL01", 22, 37, 118, 133, 1), 
            new printmenupic("Root/data/art/PrintMenu/fis1", 139, 49, 203, 113, "Root/data/art/PrintMenu/HL02", 122, 37, 218, 133, 1) ];

        foreach (var defaultpics : this.defaultpics) {
            this.imagelist.__append(defaultpics);
        }
        this.printerglyphs();
        foreach (var imagelist : this.imagelist) {
            imagelist.initfull();
        }
        this.printer = scprinter::create();
        this.printlock = 0;
        this.printtext = new gs_legotext("Root/Data/Art/Fonts/BionicleFont", "Printing...", 320, 460, 0, 1.0, 256, 4, 0, 1);
        return null;
    }
    
    method cleanupfull() {
        this.cleanupshort();
        this.parent = null;
        this.printer = null;
        if (this.printtext != null) {
            this.printtext.cleanupfull();
            this.printtext = null;
        }
        return null;
    }
    
    method cleanupshort() {
        var var1;
        this.active = 0;
        if (this.background1 != null) {
            this.background1.hide();
            this.background1.remove();
            this.background1.cleanupfull();
            this.background1 = null;
        }
        if (this.backopt1 != null) {
            this.backopt1.cleanupfull();
            this.backopt1 = null;
        }
        if (this.imagelist != null) {
            var1 = 0;
            while ((this.imagelist.__length - 1) >= var1) {
                this.imagelist[var1].cleanupfull();
                this.imagelist[var1] = null;
                var1 = var1 + 1;
            }
            this.imagelist = null;
        }        
        if (this.defaultpics != null) {
            var1 = 0;
