class extras : gs_lego_screenfrontend {
    property curoption;
    property optarray;
    property backoption;
    property active;
    property printmenu;
    property glossarymenu;
    property theaterscreen;
    property print;
    property glossary;
    property theater;
    
    method extras(param1) {
        this.parent = param1;
        this.active = 0;
        return null;
    }

    method setupoutsidescreens() {
        this.print = new gsprintmenu(this);
        this.glossary = new gsglossary(this);
        this.theater = new theaterscreen(this);
        return null;
    }
    
    method initfull() {
        this.curoption = -1;
        this.optarray = [  ];
        this.glossarymenu = new menuoption(gcareadirector::getscriptfluffstring(scslosifoundation::stringtoidentifier("fend"), 1, 20), "", this.optarray.__length);
        this.glossarymenu.initfull();
        this.optarray.__append(this.glossarymenu);
        this.printmenu = new menuoption(gcareadirector::getscriptfluffstring(scslosifoundation::stringtoidentifier("fend"), 1, 40), "", this.optarray.__length);
        this.printmenu.initfull();
        this.optarray.__append(this.printmenu);
        this.theaterscreen = new menuoption(gcareadirector::getscriptfluffstring(scslosifoundation::stringtoidentifier("fend"), 1, 72), "", this.optarray.__length);
        this.theaterscreen.initfull();
        this.optarray.__append(this.theaterscreen);
        this.backoption = new menuoption(gcareadirector::getscriptfluffstring(scslosifoundation::stringtoidentifier("fend"), 1, 3), "", this.optarray.__length);
        this.backoption.initfull();
        this.optarray.__append(this.backoption);
        this.active = 1;
        this.setupoutsidescreens();

        //force refresh the cursor to ensure returning from submenus here doesnt re-render text on top
        this.parent.refresh_cursor();
        return null;
    }
    
    method cleanupfull() {
        if (this.optarray != null) {
            this.cleanupshort();
        }
        this.curscreen = null;
        if (this.print != null) {
            this.print.cleanupfull();
            this.print = null;
        }
        if (this.glossary != null) {
            this.glossary.cleanupfull();
            this.glossary = null;
        }
        if (this.theater != null) {
            this.theater.cleanupfull();
            this.theater = null;
        }
        return null;
    }
    
    method cleanupshort() {
        var var1;
        var var2;
        this.active = 0;
        if (this.optarray != null) {
            var1 = this.optarray.__length - 1;
            var2 = 0;
            while (var1 >= var2) {
                this.optarray[var1 - var2].cleanupfull();
                this.optarray[var1 - var2] = null;
                var2 = var2 + 1;
            }
            this.optarray = null;
        }
        this.glossarymenu.cleanupfull();
        this.glossarymenu = null;
        this.printmenu.cleanupfull();
        this.printmenu = null;
        this.theaterscreen.cleanupfull();
        this.theaterscreen = null;
        this.backoption.cleanupfull();
        this.backoption = null;
        return null;
    }
    
    method input(param1) {
        if (this.active) {
            if (this.curoption == 3) {
				debug::print("[][][] back");
                this.back();
            }
            else if (this.curscreen == 4) {
                this.glossary.input(param1);
            }
            else if (this.curscreen == 5) {
                this.print.input(param1);
            }
            else if (this.curscreen == 7) {
                this.theater.input(param1);
            }
            if (param1.event == 2) {
                if ((param1.button == 27) || (param1.button == 8)) {
                    this.back();
                }
            }
        }
        return null;
    }
    
    method onevent(param1) {
        if (this.active) {
            if (param1.eventid == 25) {
                debug::print("[][][] mouse button released : " + __tostring(param1.args[0]));
                this.mousebuttonreleased(param1.args[0]);
            }
            else if (param1.eventid == 26) {
                this.mousex = param1.args[0];
                this.mousey = param1.args[1];
                this.checkmousepos();
            }
        }
        else if (this.curscreen == 4) {
            this.glossary.onevent(param1);
        }
        else if (this.curscreen == 5) {
            this.print.onevent(param1);
        }
        else if (this.curscreen == 7) {
            this.theater.onevent(param1);
        }
        return null;
    }

    method process(param1) {
        if (this.curscreen == 5) {
            this.print.process(param1);
            debug::print("[][][] print process");
        }
        return null;
    }

    method exit() {
        this.parent = null;
        return null;
    }
    
    method checkmousepos() {
        var var1;
        var var2;
        var1 = -1;
        var2 = 0;
        while ((this.optarray.__length - 1) >= var2) {
            if (this.optarray[var2].check(this.mousex, this.mousey) == 1) {
                var1 = var2;
            }
            var2 = var2 + 1;
        }
        this.curoption = var1;
        return null;
    }
    
    method mousebuttonreleased(param1) {
        if (param1 == 1) {
            if (this.curoption == -1) {
            
            }
            else if (this.curoption == 0) {
                this.glossary.initfull();
                this.gotodifferentscreen(4);
                this.cleanupshort();
                debug::print("[][][] glossary");
                gcstaticsoundsptrarray::playtablesound(1074);
            }
            else if (this.curoption == 1) {
                this.print.initfull();
                this.gotodifferentscreen(5);
                this.cleanupshort();
                this.process();
                debug::print("[][][] printmenu");
                gcstaticsoundsptrarray::playtablesound(1074);
            }
            else if (this.curoption == 2) {
                this.theater.initfull();
                this.gotodifferentscreen(7);
                this.cleanupshort();
                debug::print("[][][] theater");
                gcstaticsoundsptrarray::playtablesound(1074);
            }
            else if (this.curoption == 3) {
                this.back();
            }
        }
        else if (param1 == 2) {
            this.back();
        }
        this.curoption;
        return null;
    }

    method gotodifferentscreen(screen_id) {
        this.curscreen = screen_id;

        //force refresh the cursor so text doesnt render on top of it
        this.parent.refresh_cursor();
        return null;
    }
    
    method back() {
        debug::print("[][][] back");
        this.cleanupfull();
        this.parent.back();
        gcstaticsoundsptrarray::playtablesound(1073);
        return null;
    }
}