class gs_legotext : ss_basetext {
    property newfont;
    
    method gs_legotext(font_name, string, x_pos, y_pos, z_depth, scale, horizontal_alignment, vertical_alignment, padding, is_new_font, useStaticCoord) {
        if (is_new_font == null) {
            this.newfont = 0;
        }
        else {
            this.newfont = is_new_font;
        }
        this.fontname = font_name;
        this.string = string;
        if (padding != null) {
            this.padadjustment = padding * screenyratio;
        }
        else {
            this.padadjustment = 0;
        }
        //Ensuring this is a bool 0 or 1
        if (useStaticCoord != null) {
            if (useStaticCoord >= 1) {
                useStaticCoord = 1;
            }
        }
        else {
            useStaticCoord = 0;
        }
        if (x_pos != null) {
            if ((useStaticCoord == 0) || (useStaticCoord == null)) {
                this.x1 = (x_pos * screenratio);
            }
            else {
                this.x1 = x_pos;
            }
        }
        else {
            this.x1 = 0;
        }
        if (y_pos != null) {
            if ((useStaticCoord == 0) || (useStaticCoord == null)) {
                this.y1 = (y_pos * screenyratio) + this.padadjustment;
            }
            else {
                this.y1 = y_pos + this.padadjustment;
            }
        }
        else {
            this.y1 = 0;
        }
        if (z_depth != null) {
            this.z = z_depth;
        }
        else {
            this.z = 0;
        }
        if (scale != null) {
            //if ((useStaticCoord == 0) || (useStaticCoord == null)) {
                this.x_scale = scale * screenyratio;
                this.y_scale = scale * screenyratio;
            //}
            //else {
            //    this.x_scale = scale;
            //    this.y_scale = scale;
            //}
        }
        else {
            this.x_scale = 1;
            this.y_scale = 1;
        }
        if (horizontal_alignment != null) {
            this.horizontal = horizontal_alignment;
        }
        else {
            this.horizontal = 0;
        }
        if (vertical_alignment != null) {
            this.verticle = vertical_alignment;
        }
        else {
            this.verticle = 4;
        }
        return null;
    }
    
    method initfull() {
        if (this.newfont == 1) {
            this.font = sctilefont::create(this.fontname);
        }
        else {
            this.font = globalclass.getgamefont(this.fontname);
        }
        this.text = sctextobject::create(this.x1, this.y1, this.z, this.font, this.string);
        sctextobject::setscale(this.text, this.x_scale, this.y_scale);
        sctextobject::setjustification(this.text, this.horizontal | this.verticle);
        sctextobject::enablejustification(this.text, 1);
        return null;
    }
    
    method initshort() {
        this.initfull();
        return null;
    }
    
    method cleanupfull() {
        if (this.onscreen) {
            this.hide();
        }
        this.remove();
        this.font = null;
        this.text = null;
        return null;
    }
    
    method cleanupshort() {
        this.cleanupfulll();
        return null;
    }
    
    method breakup(param1) {
        var var1;
        var var2;
        var var3;
        var var4;
        if (scslosistringfuncs::length(this.string) > param1) {
            var1 = scslosistringfuncs::left(this.string, param1);
            var2 = scslosistringfuncs::findrev(var1, " ");
            var1 = scslosistringfuncs::left(this.string, var2);
            var3 = scslosistringfuncs::right(this.string, (scslosistringfuncs::length(this.string) - var2) - 1);
            if (scslosistringfuncs::length(var3) > param1) {
                this.string = var3;
                var3 = scslosistringfuncs::left(this.string, param1);
                var2 = scslosistringfuncs::findrev(var3, " ");
                var3 = scslosistringfuncs::left(this.string, var2);
                var4 = scslosistringfuncs::right(this.string, (scslosistringfuncs::length(this.string) - var2) - 1);
                var3 = (var3 + "\n") + var4;
            }
            this.string = (var1 + "\n") + var3;
            this.setstring(this.string);
        }
        return null;
    }
    
    method scalefont(x_scale, y_scale) {
        this.x_scale = x_scale * screenyratio;
        if (y_scale != null) {
            this.y_scale = y_scale * screenyratio;                         
        }
        else {
            this.y_scale = this.x_scale;
        }
        sctextobject::setscale(this.text, this.x_scale, this.y_scale);
        return null;
    }
}