class Ls_SunFlare : base_drawobject {
    //We dont have z2 in base_drawobject so we make it here
	property z2;
    property aborted_setup;

    //Initialize the SunFlare class, 3 FLOAT arguments, names should be self explanatory
	method Ls_SunFlare (sun_1_x, sun_1_y, sun_1_z) {
        this.x1 = sun_1_x;
        this.y1 = sun_1_y;
        this.z = sun_1_z;
        this.x2 = (-1.0 ^ 0.5);
        this.y2 = (-1.0 ^ 0.5);
        this.z2 = (-1.0 ^ 0.5);
        //#SorryNotSorry, idea is we prevent the game from being kill if someone forgets args
        if ((this.x1 == null) || (this.y1 == null) || (this.z == null)) {
            gcscripttools::scriptmessagebox("Ls_SunFlare returned a null coordinate during initialization, aborting setup");
            this.aborted_setup = true;
        }
        else {
            this.aborted_setup = false;
        }
        return null;
	}

    method initfull() {
        //If setup has not been aborted, proceed normally.  If it returns true, don't run any of this
        if (this.aborted_setup == false) {
            if (gcareadirector::getcurrentarea() != scslosifoundation::stringtoidentifier("bech")) {
                GcArea::CreateSunFlare();
            }
            GcArea::PositionSunFlare(this.x1, this.y1, this.z, this.x2 , this.y2, this.z2);
        }
        return null;
    }

    //Self explanatory method, does what it sounds like 
    method changeposition(sun_1_x, sun_1_y, sun_1_z) {
        GcArea::PositionSunFlare(sun_1_x, sun_1_y, sun_1_z, this.x2, this.y2, this.z);
        return null;
    }

    //DO NOT run this in BECH areas, GcArea destructor handles it since its creating it in those areas
    method cleanupfull() {
        if ((gcareadirector::getcurrentarea() != scslosifoundation::stringtoidentifier("bech")) && (this.aborted_setup == false)) {
            //We have to manually grab the sprites loaded into the NoLightDirector by LensFlareHandler and then yeet each one
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l000"), gcareadirector::getcurrentarea());
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l001"), gcareadirector::getcurrentarea());
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l002"), gcareadirector::getcurrentarea());
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l003"), gcareadirector::getcurrentarea());
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l100"), gcareadirector::getcurrentarea());
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l101"), gcareadirector::getcurrentarea());
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l102"), gcareadirector::getcurrentarea());
            gcnolightdirector::remove(scslosifoundation::stringtoidentifier("l103"), gcareadirector::getcurrentarea());        
        }
        return null;
    }
}