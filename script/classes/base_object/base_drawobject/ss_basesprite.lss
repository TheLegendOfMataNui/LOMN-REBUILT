class ss_basesprite : base_drawobject {
    property filename;
    property sprite;
    property handle;
    
    method ss_basesprite(file_path, leftSide, topSide, z_depth, rightSide, bottomSide, useStaticCoord, alpha) {
        this.filename = file_path;
        //Ensuring this is a bool 0 or 1
        if (useStaticCoord != null) {
            if (useStaticCoord >= 1) {
                useStaticCoord = 1;
            }
        }
        else {
            useStaticCoord = 0;
        }
        if (leftSide != null) {
            if (useStaticCoord == 0) {
                this.x1 = leftSide * screenratio;
            }
            else {
                this.x1 = leftSide;
            }
        }
        else {
            this.x1 = 0;
        }
        if (topSide != null) {
            if (useStaticCoord == 0) {
                this.y1 = (topSide * screenyratio);
            }
            else {
                this.y1 = topSide;
            }
        }
        else {
            this.y1 = 0;
        }
        if (z_depth != null) {
            this.z = z_depth;
        }
        else {
            this.z = 0;
        }
        if (rightSide != null) {
            if (useStaticCoord == 0) {
                this.x2 = this.xOffset2(rightSide);
            }
            else {
                this.x2 = rightSide;
            }
        }
        else {
            this.x2 = 0;
        }
        if (bottomSide != null) {
            if (useStaticCoord == 0) {
                this.y2 = (bottomSide * screenyratio);
            }
            else {
                this.y2 = bottomSide;
            }
        }
        else {
            this.y2 = 0;
        }
        if (alpha != null) {
            this.transval = alpha;
        }
        else {
            this.transval = 255;
        }
        return null;
    }
    
    method xOffset(baseOffset) {
        if (((screenx / screeny) > 1.4) && (baseOffset != 0) ) {
            var altOffset = (baseOffset + ((screenx - 640) * (screenyratio / 10)));
            return altOffset;
        }
        else {
            var altOffset = (baseOffset * screenratio);
            return altOffset;
        }
    }
    method xOffset2(baseOffset) {
        if (((screenx / screeny) > 1.4) && (baseOffset != 0) ) {
            var altOffset = (baseOffset + ((screenx - 640) * (screenratio / 100)));
            return altOffset;
        }
        else {
            var altOffset = (baseOffset * screenratio);
            return altOffset;
        }
    }

    method initfull() {
        this.sprite = gcbigsprite::loadhudsprite(this.x1, this.y1, this.x2, this.y2, this.filename, 0);
        gcbigsprite::setzdepth(this.sprite, this.z);
        return null;
    }
    
    method initshort() {
        this.initfull();
        return null;
    }
    
    method cleanupfull() {
        if (this.handle != null) {
            gchuddirector::remove(this.handle);
        }
        this.sprite = null;
        this.handle = null;
        return null;
    }
    
    method cleanupshort() {
        this.cleanupfull();
        return null;
    }
    
    method add() {
        this.handle = gchuddirector::addbigsprite(this.sprite);
        return null;
    }
    
    method remove() {
        if (this.handle != null) {
            gchuddirector::remove(this.handle);
            this.handle = null;
        }
        return null;
    }
    
    method show() {
        gchuddirector::show(this.handle);
        this.onscreen = 1;
        return null;
    }
    
    method hide() {
        if (this.handle != null) {
            gchuddirector::hide(this.handle);
            this.onscreen = 0;
        }
        return null;
    }
    
    method setpos(leftSide, topSide, rightSide, bottomSide) {
        if (leftSide != null) {
            this.x1 = leftSide * screenratio;
        }
        if (topSide != null) {
            this.y1 = topSide * screenyratio;
        }
        if (rightSide != null) {
            this.x2 = rightSide * screenratio;
        }
        if (bottomSide != null) {
            this.y2 = bottomSide * screenyratio;
        }
        gcbigsprite::sethudposition(this.sprite, this.x1, this.y1, this.x2, this.y2);
        return null;
    }
    
    method changepos(x_offset, y_offset) {
        if (x_offset != null) {
            this.x1 = this.x1 + (x_offset * screenratio);
            this.x2 = this.x2 + (x_offset * screenratio);
        }
        if (y_offset != null) {
            this.y1 = this.y1 + (y_offset * screenyratio);
            this.y2 = this.y2 + (y_offset * screenyratio);
        }
        gcbigsprite::sethudposition(this.sprite, this.x1, this.y1, this.x2, this.y2);
        return null;
    }
    
    method stretch(left_stretch, top_stretch, right_stretch, bottom_stretch) {
        if (left_stretch != null) {
            this.x1 = this.x1 + (left_stretch * screenratio);
        }
        if (top_stretch != null) {
            this.y1 = this.y1 + (top_stretch * screenyratio);
        }
        if (right_stretch != null) {
            this.x2 = this.x2 + (right_stretch * screenratio);
        }
        if (bottom_stretch != null) {
            this.y2 = this.y2 + (bottom_stretch * screenyratio);
        }
        gcbigsprite::sethudposition(this.sprite, this.x1, this.y1, this.x2, this.y2);
        return null;
    }

    method setzvalue(z_depth) {
        if (z_depth != null) {
            this.z = z_depth;
        }
        gcbigsprite::setzdepth(this.sprite, this.z);
        return null;
    }
    
    method enabletransparency(bool) {
        var var1;
        if (bool != null) {
            var1 = bool;
        }
        else {
            var1 = 1;
        }
        gcbigsprite::enabletransparency(this.sprite, bool);
        return null;
    }
    
    method settransparency(int) {
        this.transval = int;
        gcbigsprite::settransparency(this.sprite, this.transval);
        return null;
    }
    
    method enablealphachannel(bool) {
        //default is true
        var var1;
        if (bool != null) {
            var1 = bool;
        }
        else {
            var1 = 1;
        }
        gcbigsprite::enablealphachannel(this.sprite, bool);
        return null;
    }
    
    method setcolor(red, green, blue, alpha) {
        gcbigsprite::setcolor(this.sprite, red, green, blue, alpha);
        return null;
    }
}