class ss_basesprite : base_drawobject {
    property filename;
    property sprite;
    property handle;
    property faderate;
    property fadetimeleft;
    property incrementor;
    property decrementor;
    property blnshow;
    property blnhide;

    method ss_basesprite(file_path, leftSide, topSide, z_depth, rightSide, bottomSide, alignmentSlot, alpha) {
        this.filename = file_path;
        if (leftSide != null) {
            this.x1 = leftSide;
        }
        else {
            this.x1 = 0;
        }
        if (topSide != null) {
            this.y1 = topSide;
        }
        else {        
            this.y1 = 0;
        }
        if (rightSide != null) {
            this.x2 = rightSide;
        }
        else {
            this.x2 = 0;
        }
        if (bottomSide != null) {
            this.y2 = bottomSide;
        }
        else {
            this.y2 = 0;
        }        
        //This doesn't even technically function because Saffire forgor z-depth in native
        if (z_depth != null) {
            this.z = z_depth;
        }
        else {
            this.z = 0;
        }
        if (alpha != null) {
            this.transval = alpha;
        }
        else {
            this.transval = 255;
        }
        return null;
    }
    
    method initfull() {
        this.sprite = gcbigsprite::loadhudsprite(this.x1, this.y1, this.x2, this.y2, this.filename, 0);
        gcbigsprite::setzdepth(this.sprite, this.z);
        this.setpos(this.x1, this.y1, this.x2, this.y2);
        return null;
    }
    
    method initshort() {
        this.initfull();
        return null;
    }
    
    method cleanupfull() {
        if (this.handle != null) {
            gchuddirector::remove(this.handle);
        }
        this.sprite = null;
        this.handle = null;
        return null;
    }
    
    method cleanupshort() {
        this.cleanupfull();
        return null;
    }
    
    method add() {
        this.handle = gchuddirector::addbigsprite(this.sprite);
        return null;
    }
    
    method remove() {
        if (this.handle != null) {
            gchuddirector::remove(this.handle);
            this.handle = null;
        }
        return null;
    }
    
    method show() {
        gchuddirector::show(this.handle);
        this.onscreen = 1;
        return null;
    }
    
    method hide() {
        if (this.handle != null) {
            gchuddirector::hide(this.handle);
            this.onscreen = 0;
        }
        return null;
    }
    
    method setpos(leftSide, topSide, rightSide, bottomSide) {
        if (leftSide != null) {
            this.x1 = leftSide * screenratio;
        }
        if (topSide != null) {
            this.y1 = topSide * screenyratio;
        }
        if (rightSide != null) {
            this.x2 = rightSide * screenratio;
        }
        if (bottomSide != null) {
            this.y2 = bottomSide * screenyratio;
        }
        gcbigsprite::sethudposition(this.sprite, this.x1, this.y1, this.x2, this.y2);
        return null;
    }
    
    method changepos(x_offset, y_offset) {
        if (x_offset != null) {
            this.x1 = this.x1 + (x_offset * screenratio);
            this.x2 = this.x2 + (x_offset * screenratio);
        }
        if (y_offset != null) {
            this.y1 = this.y1 + (y_offset * screenyratio);
            this.y2 = this.y2 + (y_offset * screenyratio);
        }
        gcbigsprite::sethudposition(this.sprite, this.x1, this.y1, this.x2, this.y2);
        return null;
    }
    
    method stretch(left_stretch, top_stretch, right_stretch, bottom_stretch) {
        if (left_stretch != null) {
            this.x1 = this.x1 + (left_stretch * screenratio);
        }
        if (top_stretch != null) {
            this.y1 = this.y1 + (top_stretch * screenyratio);
        }
        if (right_stretch != null) {
            this.x2 = this.x2 + (right_stretch * screenratio);
        }
        if (bottom_stretch != null) {
            this.y2 = this.y2 + (bottom_stretch * screenyratio);
        }
        gcbigsprite::sethudposition(this.sprite, this.x1, this.y1, this.x2, this.y2);
        return null;
    }

    method setzvalue(z_depth) {
        if (z_depth != null) {
            this.z = z_depth;
        }
        gcbigsprite::setzdepth(this.sprite, this.z);
        return null;
    }
    
    method enabletransparency(bool) {
        //defaults to true if no arg passed
        if (bool == null) {
            bool = 1;
        }
        gcbigsprite::enabletransparency(this.sprite, bool);
        return null;
    }
    
    method settransparency(float) {
        this.transval = floatt;
        gcbigsprite::settransparency(this.sprite, this.transval);
        return null;
    }
    
    //Seems the game has the alpha channel enabled by default?
    method enablealphachannel(bool) {
        //defaults to true if no arg passed
        if (bool == null) {
            bool = 1;
        }
        gcbigsprite::enablealphachannel(this.sprite, bool);
        return null;
    }
    
    method setcolor(red, green, blue, alpha) {
        gcbigsprite::setcolor(this.sprite, red, green, blue, alpha);
        return null;
    }

    method process(param1) {
        if (this.blnshow) {
            this.fadetimeleft = this.fadetimeleft - param1.deltatime;
            if (this.fadetimeleft <= 0) {
                this.fadetimeleft = 0;
            }
            this.setincrementvalue();
        }
        if (this.blnhide) {
            this.fadetimeleft = this.fadetimeleft - param1.deltatime;
            if (this.fadetimeleft <= 0) {
                this.fadetimeleft = 0;
            }
            this.setdecrementvalue();
        }
        return null;
    }

    method setincrementvalue() {
        this.incrementor = 255 - (255 * (this.fadetimeleft / this.faderate));
        this.settransparency(this.incrementor);
        if (this.incrementor == 255) {
            this.incrementor = 0;
            this.blnshow = 0;
        }
        return null;
    }
    
    method setdecrementvalue() {
        this.decrementor = 255 * (this.fadetimeleft / this.faderate);
        this.settransparency(this.decrementor);
        if (this.decrementor == 0) {
            this.hide();
            this.blnhide = 0;
        }
        return null;
    }

    method setfaderate(fadeRate) {
        this.faderate = fadeRate;
        return null;
    }

    method fadein(fadeinRate) {
        this.show();
        this.enabletransparency(1);
        this.blnshow = 1;
        this.blnhide = 0;
        if (fadeinRate == null) {
            //If no argument passed, set this to a default of 1.0
            this.faderate = 1.0;
        }
        else {
            this.faderate = fadeinRate;
        }
        this.fadetimeleft = this.faderate;
        return null;
    }
    
    method fadeout(fadeoutRate) {
        this.decrementor = 255;
        this.show();
        this.enabletransparency(1);
        this.blnhide = 1;
        this.blnshow = 0;
        if (fadeoutRate == null) {
            //If no argument passed, set this to a default of 1.0
            this.faderate = 1.0;
        }
        else {
            this.faderate = fadeoutRate;
        }
        this.fadetimeleft = this.faderate;
        return null;
    }
}
