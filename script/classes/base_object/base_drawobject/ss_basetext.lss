class ss_basetext : base_drawobject {
    property font;
    property fontname;
    property text;
    property string;
    property ident;
    property horizontal;
    property verticle;
    property x_scale;
    property y_scale;
    property padadjustment;
    property scale;
    
    method ss_basetext(font_name, string, x_pos, y_pos, z_depth, scale, horizontal_alignment, vertical_alignment, padding) {
        this.fontname = font_name;
        this.string = string;
        if (padding != null) {
            this.padadjustment = padding * screenyratio;
        }
        else {
            this.padadjustment = 0;
        }
        if (x_pos != null) {
            this.x1 = (x_pos * screenratio);
        }
        else {
            this.x1 = 0;
        }
        if (y_pos != null) {
            this.y1 = (y_pos * screenyratio) + this.padadjustment;
        }
        else {
            this.y1 = 0;
        }
        if (z_depth != null) {
            this.z = z_depth;
        }
        else {
            this.z = 0;
        }
        if (scale != null) {
            this.x_scale = scale * screenyratio;
            this.y_scale = scale * screenyratio;
        }
        else {
            this.x_scale = 1;
            this.y_scale = 1;
        }
        if (horizontal_alignment != null) {
            this.horizontal = horizontal_alignment;
        }
        else {
            this.horizontal = 0;
        }
        if (vertical_alignment != null) {
            this.verticle = vertical_alignment;
        }
        else {
            this.verticle = 4;
        }
        return null;
    }
    
    method initfull() {
        this.font = sctilefont::create(this.fontname);
        this.text = sctextobject::create(this.x1, this.y1, this.z, this.font, this.string);
        sctextobject::setscale(this.text, this.x_scale, this.y_scale);
        sctilefont::setscale(this.font, this.x_scale, this.y_scale);
        sctextobject::setjustification(this.text, this.horizontal | this.verticle);
        sctextobject::enablejustification(this.text, 1);
        return null;
    }
    
    method initshort() {
        this.font = sctilefont::create(this.fontname);
        this.text = sctextobject::create(this.x1, this.y1, this.z, this.font, this.string);
        sctilefont::setscale(this.font, this.x_scale, this.y_scale);
        sctextobject::setjustification(this.text, this.horizontal | this.verticle);
        sctextobject::enablejustification(this.text, 1);
        return null;
    }
    
    method cleanupfull() {
        if (this.onscreen) {
            this.hide();
        }
        this.remove();
        this.font = null;
        this.text = null;
        return null;
    }
    
    method cleanupshort() {
        this.cleanupfulll();
        return null;
    }
    
    method enablealphachannel(param1) {
        return null;
    }
    
    method add() {
        this.ident = gchuddirector::addtextobject(this.text);
        debug::print("Adding text to HUD director with identifier of:");
        debug::print(this.ident);
        return null;
    }
    
    method show() {
        gchuddirector::show(this.ident);
        this.onscreen = 1;
        return null;
    }
    
    method hide() {
        gchuddirector::hide(this.ident);
        this.onscreen = 0;
        return null;
    }
    
    method remove() {
        debug::print("Removing text with identifier of:");
        if (this.ident != null) {
            debug::print(__tostring(this.ident));
        }
        else {
            debug::print("IDENT RETURNED NULL, RECHECK CODE YOU MONKEY");
        }
        gchuddirector::remove(this.ident);
        return null;
    }
    
    method setpos(x_pos, y_pos, z_depth) {
        if (x_pos != null) {
            this.x1 = x_pos * screenratio;
        }
        if (y_pos != null) {
            this.y1 = (y_pos * screenyratio) + this.padadjustment;
        }
        if (z_depth != null) {
            this.z = z_depth;
        }
        sctextobject::setposition(this.text, this.x1, this.y1, this.z);
        return null;
    }
    
    method setjustification(param1, param2) {
        this.horizontal = param1;
        this.verticle = param2;
        sctextobject::setjustification(this.text, this.horizontal | this.verticle);
        sctextobject::enablejustification(this.text, 1);
        return null;
    }
    
    method changepos(x_offset, y_offset, z_offset) {
        if (x_offset != null) {
            this.x1 = (x_offset * screenratio) + this.x1;
        }
        if (y_offset != null) {
            this.y1 = (y_offset * screenyratio) + this.y1;
        }
        if (z_offset != null) {
            this.z = z_offset + this.z;
        }
        sctextobject::setposition(this.text, this.x1, this.y1, this.z);
        return null;
    }
    
    method setstring(param1) {
        this.string = param1;
        sctextobject::setstring(this.text, this.string);
        return null;
    }
    
    method setfont(param1) {
        this.fontname = param1;
        sctilefont::create(this.fontname);
        sctextobject::setfont(this.text, this.font);
        return null;
    }
    
    method scalefont(x_scale, y_scale) {
        this.x_scale = x_scale * screenyratio;
        if (y_scale != null) {
            this.y_scale = y_scale * screenyratio;                         
        }
        else {
            this.y_scale = this.x_scale;
        }
        sctilefont::setscale(this.font, this.x_scale, this.y_scale);
        return null;
    }
    
    method getheight() {
        return sctilefont::getfontheight(this.font);
    }
    
    method getwidth() {
        return sctilefont::getstrlen(this.font, this.string);
    }
    
    method setkerning(param1) {
        var var1;
        var1 = param1;
        sctilefont::setkerning(this.font, var1);
        return null;
    }
    
    method settransparency(param1) {
        sctextobject::settransparency(this.text, param1);
        return null;
    }
    
    method setcolor(red, green, blue, alpha) {
        sctilefont::setcolor(this.font, red, green, blue, alpha);
        return null;
    }
}