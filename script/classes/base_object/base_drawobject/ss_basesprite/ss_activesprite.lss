class ss_activesprite : ss_basesprite {
    property filename2;
    
    method ss_activesprite(file_path, file_path2, leftSide, topSide, z_depth, rightSide, bottomSide, useStaticCoord, alpha) {
        this.ss_basesprite(file_path, leftSide, topSide, z_depth, rightSide, bottomSide, useStaticCoord, alpha);
        this.filename2 = file_path2;
        return null;
    }
    
    method setactive() {
        this.hide();
        this.remove();
        this.sprite = gcbigsprite::loadhudsprite(this.x1, this.y1, this.x2, this.y2, this.filename2, 0);
        gcbigsprite::setzdepth(this.sprite, this.z);
        this.enablealphachannel(1);
        this.add();
        this.show();
        return null;
    }
    
    method setinactive() {
        this.hide();
        this.remove();
        this.sprite = gcbigsprite::loadhudsprite(this.x1, this.y1, this.x2, this.y2, this.filename, 0);
        gcbigsprite::setzdepth(this.sprite, this.z);
        this.enablealphachannel(1);
        this.add();
        this.show();
        return null;
    }
}