class mudmonster {
    property mudman;
    property ppuzzle;
    property mudstate;
    property mudballs;
    property curmudball;
    property miniboulders;
    property resetmboulders;
    property shakeonce;
    property boulderuse;
    property projoffsetx;
    property projoffsety;
    property projoffsetz;
    property boneindex;
    
    method mudmonster(param1) {
        this.ppuzzle = param1;
        return null;
    }
    
    method init() {
        this.mudman = gcmudboss::createmudboss("mudm", 1836409945);
        this.boneindex = gcmudboss::getboneindex(this.mudman, 2063160759);
        gcmudboss::setup(this.mudman, 995, 0, 212, -90, 40);
        this.mudballs = [ new sprite_projectile("mbb0", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb1", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb2", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb3", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb4", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb5", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb6", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb7", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb8", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1), 
            new sprite_projectile("mbb9", "bld0", "Root/data/levels/lev1/mdmn", 45, 1, 100, 0, 1) ];
        this.miniboulders = [ new lego_projectileobject("smb1", this.ppuzzle.parent.name), 
            new lego_projectileobject("smb2", this.ppuzzle.parent.name), 
            new lego_projectileobject("smb3", this.ppuzzle.parent.name), 
            new lego_projectileobject("smb4", this.ppuzzle.parent.name), 
            new lego_projectileobject("smb5", this.ppuzzle.parent.name), 
            new lego_projectileobject("smb6", this.ppuzzle.parent.name), 
            new lego_projectileobject("smb7", this.ppuzzle.parent.name), 
            new lego_projectileobject("smb8", this.ppuzzle.parent.name) ];
        this.resetmboulders = new lego_timer("mbt9", 5.1, 0);
        this.resetmboulders.initfull();
        foreach (var miniboulders : this.miniboulders) {
            miniboulders.init(0.1, 0, 0, 0, 0, 0.8, "bld0", "Root/data/levels/lev1/mdmn", 60);
            miniboulders.setresponse(4, 4, 4);
            miniboulders.setposition(0.0, 0.0, 0.0);
            miniboulders.ignorecollisionswith(1836409945);
            miniboulders.show();
            miniboulders.setbounceeventrepoert(1);
        }        
        this.shakeonce = 1;
        this.projoffsetx = 11;
        this.projoffsety = 12;
        this.projoffsetz = 10;
        this.mudstate = 6;
        this.curmudball = 0;
        this.boulderuse = 1;
        return null;
    }
    
    method reset() {
        debug::print("Calling reset");
        gcmudboss::reset(this.mudman, 995, 0, 212, -90);
        gcmudboss::morph(this.mudman, 3, 2.0);
        gccharacter::setsplitanimation(gcmodeldirector::getcharacter(1836409945), 1831874864, -1);
        gcmodeldirector::show(1836409945, 1836409945);
        this.mudstate = 5;
        this.curmudball = 0;
        this.resetmboulders.reset();
        foreach (var miniboulders : this.miniboulders) {
            miniboulders.setposition(0.0, 0.0, 0.0);
        }     
        this.boulderuse = 1;
        return null;
    }
    
    method cleanupfull() {
        var var1;
        debug::print("Calling cleanup full for the mudmonster");
        if (this.miniboulders != null) {
            var1 = 0;
            while ((this.miniboulders.__length - 1) >= var1) {
                this.miniboulders[var1].cleanupfull();
                this.miniboulders[var1] = null;
                var1 = var1 + 1;
            }
            this.miniboulders = null;
        }
        debug::print("Cleaning up miniboulders");
        if (this.mudballs != null) {
            var1 = 0;
            while ((this.mudballs.__length - 1) >= var1) {
                this.mudballs[var1].cleanupfull();
                this.mudballs[var1] = null;
                var1 = var1 + 1;
            }
            this.mudballs = null;
        }
        debug::print("Cleaning up mudballs");
        if (this.mudman != null) {
            gcmodeldirector::remove(1836409945, 0);
            this.mudman = null;
        }
        debug::print("Cleaning up the mudman");
        this.curmudball = null;
        this.mudstate = null;
        this.boulderuse = null;
        if (this.resetmboulders != null) {
            this.resetmboulders.cleanupfull();
            this.resetmboulders = null;
        }
        debug::print("Cleaning up resetBoulders");
        this.shakeonce = null;
        this.projoffsetx = null;
        this.projoffsety = null;
        this.projoffsetz = null;
        return null;
    }
    
    method cleanupshort() {
        this.cleanupfull();
        return null;
    }
    
    method onevent(param1) {
        var var1;
        if (param1.eventid == 19) {
            var1 = 0;
            while ((this.mudballs.__length - 1) >= var1) {
                if (param1.args[1] == this.mudballs[var1].id) {
                    if (param1.args[1] == scslosifoundation::stringtoidentifier("cnt1")) {
                        globalclass.player.actor.react(0, 1, this.mudballs[var1].id);
                    }
                    this.explode(this.mudballs[var1]);
                }
                var1 = var1 + 1;
            }
        }
        else if (param1.eventid == 17) {
            var1 = 0;
            while ((this.miniboulders.__length - 1) >= var1) {
                if (param1.args[0] == this.miniboulders[var1].id) {
                    this.miniboulders[var1].fadeout(1.0);
                }
                var1 = var1 + 1;
            }
        }
        else if (param1.eventid == 1) {
            var1 = 0;
            while ((this.miniboulders.__length - 1) >= var1) {
                if (param1.args[0] == this.miniboulders[var1].id) {
                    if (param1.args[1] == scslosifoundation::stringtoidentifier("cnt1")) {
                        globalclass.player.actor.react(0, 1, this.mudballs[var1].id);
                    }
                }
                var1 = var1 + 1;
            }
        }
        return null;
    }
    
    method input(param1) {
        return null;
    }
    
    method releasemudball(param1) {
        gcmudboss::throwmudball(this.mudman, this.mudballs[this.curmudball].handle, this.boneindex);
        this.curmudball = this.curmudball + 1;
        if (this.curmudball > (this.mudballs.__length - 1)) {
            this.curmudball = 0;
        }
        return null;
    }
    
    method explode(param1) {
        var var1;
        var var2;
        var var3;
        var var5;
        var var6;
        var var7;
        var var8;
        var var9;
        var var10;
        var var11;
        var1 = gcmudboss::getmudballx(this.mudman, param1.handle);
        var2 = gcmudboss::getmudbally(this.mudman, param1.handle);
        var3 = gcmudboss::getmudballz(this.mudman, param1.handle);
        foreach (var miniboulders : this.miniboulders) {
            var5 = globalclass.randnum.getrandomfloat(0.05, 0.3);
            var6 = globalclass.randnum.getrandomfloat(0 - 5.0, 5.0);
            var7 = globalclass.randnum.getrandomfloat(0.0, 5.0);
            var8 = globalclass.randnum.getrandomfloat(0 - 5.0, 5.0);
            var9 = globalclass.randnum.getrandomfloat(var1, var1 + 1.0);
            var10 = globalclass.randnum.getrandomfloat(var2, var2 + 1.0);
            var11 = globalclass.randnum.getrandomfloat(var3, var3 + 1.0);
            miniboulders.setobjscale(var5);
            miniboulders.setposition(var9, var10, var11);
            miniboulders.setalpha(0.9);
            miniboulders.setmoveableflags(1, 0, 0, 0);
            miniboulders.setvelocity(var6, var7, var8);
            gcstaticsoundsptrarray::playtablesound(1080);
        }
        this.resetmboulders.reset(0);
        this.resetmboulders.start();
        this.shakeonce = 1;
        return null;
    }
    
    method shrink() {
        gcmudboss::shrink(this.mudman, 0.2);
        this.projoffsetx = this.projoffsetx - 2;
        this.projoffsety = this.projoffsety - 2;
        this.projoffsetz = this.projoffsetz - 2;
        debug::print("DO");
        return null;
    }
}