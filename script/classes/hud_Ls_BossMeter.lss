class hud_Ls_BossMeter {
    property partsarray;
    property boss_lifebar;
    property infected_lites;
    property movement;
    property onscreen;
    property star;
    property boss_starting_hp;
    
    method hud_Ls_BossMeter() {
        return null;
    }

    method initfull(boss_health) {
        var var2;
        var var3;
        var var6;
        var var7;       
        this.movement = 0;
        this.onscreen = 1;
        this.partsarray = [  ];
        this.star = new ss_basesprite("Root/data/art/particles/star", 299, 440, 0, 339, 480);
        this.partsarray.__append(this.star);
        this.boss_lifebar = [ new ss_basesprite("Root/data/art/hud/16x16frntend__clr", 305 - (7.5 * boss_health), 452, 0, 320 - (7.5 * boss_health), 468) ];
        var2 = 1;
        while ((boss_health) >= var2) {
            var3 = new ss_basesprite("Root/data/art/hud/16x16circle__clr", (this.boss_lifebar[0].x1 - 1) + (15 * var2), 452, 0, this.boss_lifebar[0].x2 + (15 * var2), 468);
            this.boss_lifebar.__append(var3);
            var2 = var2 + 1;
        }
        this.boss_lifebar.__append(new ss_basesprite("Root/data/art/hud/16x16end__clr", 319 + (7.5 * boss_health), 452, 0, 336 + (7.5 * boss_health), 468));
        this.partsarray.__append(this.boss_lifebar);
        this.infected_lites = [  ];
        var2 = 1;
        while ((boss_health) >= var2) {
            this.infected_lites.__append(new ss_basesprite("Root/data/art/hud/littleWhiteLight", (this.boss_lifebar[0].x1 - 1) + (15 * var2), 452, 0, this.boss_lifebar[0].x2 + (15 * var2), 468));
            var2 = var2 + 1;
        }
        this.partsarray.__append(this.infected_lites);
        //actual abomination of a nested while loop what the fuck saffire
        var2 = 0;
        while ((this.partsarray.__length - 1) >= var2) {
            if (__isarray(this.partsarray[var2])) {
                var6 = this.partsarray[var2];
                var7 = 0;
                while ((var6.__length - 1) >= var7) {
                    var6[var7].initfull();
                    var7 = var7 + 1;
                }
            }
            else {
                this.partsarray[var2].initfull();
            }
            var2 = var2 + 1;
        }
        foreach (var inf_lights : this.infected_lites) {
            inf_lights.setcolor(223, 255, 27, 255);
        }        
        return null;
    }
    
    method cleanupfull() {
        var var1;
        var var2;
        if (this.infected_lites != null) {
            var1 = this.infected_lites.__length - 1;
            var2 = 0;
            while (var1 >= var2) {
                this.infected_lites[var1 - var2].hide();
                this.infected_lites[var1 - var2].remove();
                this.infected_lites[var1 - var2].cleanupfull();
                this.infected_lites[var1 - var2] = null;
                var2 = var2 + 1;
            }
            this.infected_lites = null;
        }
        if (this.boss_lifebar != null) {
            var1 = this.boss_lifebar.__length - 1;
            var2 = 0;
            while (var1 >= var2) {
                this.boss_lifebar[var1 - var2].hide();
                this.boss_lifebar[var1 - var2].remove();
                this.boss_lifebar[var1 - var2].cleanupfull();
                this.boss_lifebar[var1 - var2] = null;
                var2 = var2 + 1;
            }
            this.boss_lifebar = null;
        }
        if (this.star != null) {
            this.star.hide();
            this.star.remove();
            this.star.cleanupfull();
            this.star = null;
        }
        if (this.partsarray != null) {
            var1 = this.partsarray.__length - 1;
            var2 = 0;
            while (var1 >= var2) {
                this.partsarray[var1 - var2] = null;
                var2 = var2 + 1;
            }
            this.partsarray = null;
        }
        return null;
    }
    
    method initshort() {
        return null;
    }
    
    method cleanupshort() {
        this.hide();
        return null;
    }
    
    method add() {
        var var1;
        var var2;
        var var3;
        var1 = 0;
        while ((this.partsarray.__length - 1) >= var1) {
            if (__isarray(this.partsarray[var1])) {
                var2 = this.partsarray[var1];
                var3 = 0;
                while ((var2.__length - 1) >= var3) {
                    var2[var3].add();
                    var3 = var3 + 1;
                }
            }
            else {
                this.partsarray[var1].add();
            }
            var1 = var1 + 1;
        }
        return null;
    }
    
    method show() {
        var var1;
        var var2;
        var var3;
        var1 = 0;
        while ((this.partsarray.__length - 1) >= var1) {
            if (__isarray(this.partsarray[var1])) {
                var2 = this.partsarray[var1];
                var3 = 0;
                while ((var2.__length - 1) >= var3) {
                    var2[var3].show();
                    var3 = var3 + 1;
                }
            }
            else {
                this.partsarray[var1].show();
            }
            var1 = var1 + 1;
        }
        return null;
    }
    
    method hide() {
        var var1;
        var var2;
        var var3;
        var1 = 0;
        while ((this.partsarray.__length - 1) >= var1) {
            if (__isarray(this.partsarray[var1])) {
                var2 = this.partsarray[var1];
                var3 = 0;
                while ((var2.__length - 1) >= var3) {
                    var2[var3].hide();
                    var3 = var3 + 1;
                }
            }
            else {
                this.partsarray[var1].hide();
            }
            var1 = var1 + 1;
        }
        return null;
    }
    
    method changepos(y_adjust) {
        var var1;
        var var2;
        var1 = 0;
        var2 = 0;
        while ((this.boss_lifebar.__length - 1) >= var1) {
            this.boss_lifebar[var1].changepos(0, y_adjust);
            var1 = var1 + 1;
        }
        while ((this.infected_lites.__length - 1) >= var2) {
            this.infected_lites[var2].changepos(0, y_adjust);
            var2 = var2 + 1;
        }
        this.star.changepos(0, y_adjust);
        return null;
    }
    
    method process(param1) {
        if (this.star != null) {
            this.star.process(param1);
        }
        if ((this.movement == -1) && (this.boss_lifebar[0].y1 <= (496 * screenyratio))) {
            this.changepos(2);
            if (this.boss_lifebar[0].y1 >= (496 * screenyratio)) {
                this.movement = 0;
                this.update_boss_life(this.boss_starting_hp);
                this.hide();
                this.show();
            }
        }              
        if ((this.movement > 0) && (this.boss_lifebar[0].y1 >= (452 * screenyratio))) {
            this.changepos(-2);
            if (this.boss_lifebar[0].y1 <= (452 * screenyratio)) {
                this.movement = 0;
            }
        }            
        if ((this.movement == -2) && (this.boss_lifebar[0].y1 <= (496 * screenyratio))) {
            this.changepos(0.5);
            if (this.boss_lifebar[0].y1 >= (496 * screenyratio)) {
                this.movement = 0;
            }
        }              
        return null;
    }
    
    method onevent(param1) {
        if (param1.eventid == 1100) {
            this.boss_starting_hp = param1.args[0];
            debug::print("BossMeter Init Event");
            debug::print("Boss health: " + __tostring(this.boss_starting_hp));
            this.initfull(this.boss_starting_hp);
            this.add();
            this.slidebossmeter(0);
        }
        else if (param1.eventid == 1101) {
            debug::print("BossMeter Adjust Event");
            if (param1.args[0] == 0) {
                debug::print("Decreasing meter!");
                this.update_boss_life(-1);
            }
            else if (param1.args[0] == 1) {
                debug::print("Removing meter!");
                this.cleanupfull();
                this.boss_starting_hp = null;
            }
            else if (param1.args[0] == 2) {
                debug::print("Reseting meter!");
            }
        }
        else if (param1.eventid == 27) {
            this.slidebossmeter(1);
        }
        else if (param1.eventid == 46) {
            this.slidebossmeter(0);
        }
        return null;
    }
    
    method slidebossmeter(param1) {
        if (param1 == 0) {
            debug::print("[][BossMeter][] Slide Off");
            if (this.onscreen == 1) {
                this.movement = -1;
                this.onscreen = 0;
            }
        }        
        else if (param1 == 1) {
            debug::print("[][BossMeter][] Slide On");
            if (this.onscreen == 0) {
                this.movement = 1;
                this.onscreen = 1;
            }      
        }
        else if (param1 == 2) {
            debug::print("[][BossMeter][] Slide Off Slowly");
            if (this.onscreen == 1) {
                this.movement = -2;
                this.onscreen = 0;
            }      
        }
        return null;
    }
        
    method update_boss_life(health_int) {
        //decrement boss health
        if (health_int == -1) {
            debug::print(("[][][] Boss Life Decremented by: " + __tostring(health_int)));
            var inf_lites_length = this.infected_lites.__length - 1;
            this.infected_lites[inf_lites_length].hide();
            this.infected_lites[inf_lites_length].cleanupfull();
            this.infected_lites.__removeat(inf_lites_length);
        }
        //increment boss health
        else if (health_int >= 0) {
            debug::print(("[][][] Boss Life Incremented by: " + __tostring(health_int)));
            while (health_int > this.infected_lites.__length) {
                var inf_lites_length = this.infected_lites.__length;
                this.infected_lites.__append(new ss_basesprite("Root/data/art/hud/littleWhiteLight", (this.boss_lifebar[0].x1 - 1) + (15 * health_int), this.boss_lifebar[0].y1, 0, this.boss_lifebar[0].x2 + (15 * health_int), this.boss_lifebar[0].y2));
                this.infected_lites[inf_lites_length].initfull();
                this.infected_lites[inf_lites_length].add();
                this.infected_lites[inf_lites_length].setcolor(223, 255, 27, 255);
            }
        }
        return null;
    }
}
