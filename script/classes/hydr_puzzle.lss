class hydr_puzzle {
    property parent;
    property hydr;
    property isdead;
    property stone;
    property hasstone;
    property elemental_boss_name;
    property elemental_boss_name2;
    property showintro;
    property level_end;
    
    method hydr_puzzle(param1) {
        this.parent = param1;
        return null;
    }
    
    method initfull() {
        gcareadirector::setfog(-9143565, 0 - 1000.0, 0 - 2400.0, 0.01);
        gclightdirector::setcavelighting(0);
        gcareadirector::setnearestmax(20);
        globalclass.bgmusic.changefilename("Root/Data/sounds/Musicgalitheme");
        globalclass.bgmusic.play();
        if (gcsaver::finditem(scslosifoundation::stringtoidentifier("ston")) == 0) {
            this.stone = new lego_pickup("ston", 0, 4, "item", 9, 0);
            this.stone.initfull();
            this.stone.show();
            gcareadirector::hide(scslosifoundation::stringtoidentifier("ston"), scslosifoundation::stringtoidentifier("hydr"));
        }
        this.hasstone = 0;
        var hydr_id = scslosifoundation::stringtoidentifier("hydr");
        gcmodeldirector::addboss(hydr_id);
        gcmodeldirector::show(hydr_id, hydr_id);
        this.hydr = gchydraboss::gethydraboss();
        this.isdead = 0;
        GcHydraBoss::Idle(3);
        var hive1_handle = gcareadirector::gethive(scslosifoundation::stringtoidentifier("hv01"));
        gchive::setcreaturetype(hive1_handle, scslosifoundation::stringtoidentifier("crb1"));
        gchive::setspawnrate(hive1_handle, 240);
        var hive2_handle = gcareadirector::gethive(scslosifoundation::stringtoidentifier("hv02"));
        gchive::setcreaturetype(hive2_handle, scslosifoundation::stringtoidentifier("crb1"));
        gchive::setspawnrate(hive2_handle, 240);
        this.elemental_boss_name = new gs_legotext("Root/Data/Art/Fonts/BionicleFontshad", gcareadirector::getscriptstring(scslosifoundation::stringtoidentifier("boss"), 2, 0), 320, 410, 0, 1.5, 256, 4, 0);
        this.elemental_boss_name.initfull();
        this.elemental_boss_name.add();
        this.elemental_boss_name2 = new gs_legotext("Root/Data/Art/Fonts/BionicleFontshad", gcareadirector::getscriptstring(scslosifoundation::stringtoidentifier("boss"), 2, 1), 320, 430, 0, 1, 256, 4, 0);
        this.elemental_boss_name2.initfull();
        this.elemental_boss_name2.add();
        this.showintro = 0;
        this.playintro();
        this.level_end = 0;
        return null;
    }
    
    method playintro() {
        this.showintro = 1;
        this.parent.level.cam.makespline("Root/Data/Levels/lev2/hydr/hydr_CAM.slb");
        this.parent.level.cam.setspline(0, 10.0, 1, 0);
        this.parent.level.cam.setaimode(2);
        this.parent.level.cam.settargetpos(77, 10, 10);
        this.parent.level.cam.scaletocutscene();
        this.elemental_boss_name.fadein();
        this.elemental_boss_name2.fadein();
        globalclass.hud.hide();
        //globalclass.hud.boss_meter.slidebossmeter(1);
        GcHydraBoss::Idle(10);
        return null;
    }
    
    method playextro() {
        if ((this.hasstone == 1) && (this.isdead == 1) && (this.level_end == 0)) {
            debug::print("Begin level transition");
            globalclass.hud.fadeoutscreen();
            this.level_end = 1;
        }
        return null;
    }
    
    method cleanupfull() {
        var hydr = scslosifoundation::stringtoidentifier("hydr");
        this.hydr = null;
        gcmodeldirector::remove(hydr, hydr);
        if (this.stone != null) {
            this.stone.cleanupfull();
            this.stone = null;
        }
        this.elemental_boss_name.cleanupfull();
        this.elemental_boss_name = null;
        this.elemental_boss_name2.cleanupfull();
        this.elemental_boss_name2 = null;
        this.isdead = null;
        this.hasstone = null;
        this.showintro = null;
        this.level_end = null;
        return null;
    }
    
    method process(param1) {
        if (this.elemental_boss_name != null) {
            this.elemental_boss_name.process(param1);
            this.elemental_boss_name2.process(param1);
        }
        return null;
    }
    
    method initshort() {
        return null;
    }
    
    method resetplayer() {
        this.elemental_boss_name.fadein();
        this.elemental_boss_name2.fadein();
        gchydraboss::reset(this.hydr);
        GcHydraBoss::Idle(3);
        return null;
    }
    
    method onevent(param1) {       
        if (param1.eventid == 7) {
            if (param1.args[2] == scslosifoundation::stringtoidentifier("eBEG")) {
                gcbaseboss::emitterbegin(gcmodeldirector::getboss(scslosifoundation::stringtoidentifier("hydr")), param1.args[4], param1.args[5]);
            }
            if (param1.args[2] == scslosifoundation::stringtoidentifier("eEND")) {
                gcbaseboss::emitterend(gcmodeldirector::getboss(scslosifoundation::stringtoidentifier("hydr")), param1.args[4], param1.args[5]);
            }
        }
        else if (param1.eventid == 43) {
            if (this.isdead == 0) {
                this.elemental_boss_name.fadeout(0.5);
                this.elemental_boss_name2.fadeout(0.5);
                globalclass.hud.boss_meter.slidebossmeter(2);
                this.isdead = 1;
            }
        }
        else if (param1.eventid == 41) {
            gchydraboss::finishconversation(this.hydr);
        }
        else if (param1.eventid == 27) {
            this.resetplayer();
        }
        else if (param1.eventid == 46) {
            this.elemental_boss_name.fadeout(0.5);
            this.elemental_boss_name2.fadeout(0.5);
        }
        else if (param1.eventid == 39) {
            this.hasstone = 1;
            this.playextro();
        }
        else if (param1.eventid == 1005) {
            if (param1.args[0] == 1) {
                debug::print("Setting next level to 3");
                globalclass.setnextlevel("lev3", 1);
            }
        }
        else if (param1.eventid == 6) {
            this.parent.level.cam.setaimode(11);
            this.parent.level.cam.resetviewport();
            globalclass.hud.boss_meter.slidebossmeter(1);
            globalclass.hud.show();
            GcHydraBoss::Idle(3);
        }
        return null;
    }
    
    method input(param1) {
        return null;
    }
    
    method exit() {
        this.parent = null;
        return null;
    }
}